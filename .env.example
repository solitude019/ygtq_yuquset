# ========================================================================
# Yu Sports - Environment Variables (copy to .env and fill in real values)
# In production:  cp .env.example .env   then edit values
# ========================================================================

# ---- Server ----
# Port the Node service listens on (Aliyun: any open port, e.g. 5000 / 3000)
PORT=5000
# DEV for local/vite dev; set to PROD on the production server
COZE_PROJECT_ENV=PROD

# ---- JWT ----
# Change this to a long random string in production
JWT_SECRET=yu-secret-key-change-me-in-production

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yu_sports
DB_USER=yu
DB_PASSWORD=YuQuest2026

# ---- Upload ----
# Root directory where uploaded product images are physically stored
UPLOAD_ROOT_DIR=/opt/ygtq/product
