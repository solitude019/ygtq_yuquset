{
  "name": "projects",
  "version": "1.0.0",
  "description": "Vanilla TypeScript application with Express + Vite (HTML + CSS + TS + Node API)",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "build:client": "vite build --outDir dist/client",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "lint:style": "stylelint \"src/**/*.css\"",
    "start": "bash ./scripts/start.sh",
    "start:prod": "tsx server/server.ts",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm dlx concurrently --group --names lint-tsc,lint-build,lint-style \"pnpm ts-check\" \"pnpm lint:build\" \"pnpm lint:style\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "pg": "^8.22.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.20",
    "coze-coding-dev-sdk": "^0.7.24",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "only-allow": "^1.2.2",
    "postcss": "^8.4.49",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vite": "^7.2.4",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.27.2",
      "is-generator-function": "1.0.10"
    }
  }
}
